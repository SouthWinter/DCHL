{
  "model": "llama",
  "dataset": "babyai",
  "updates": 25,
  "primary_rollouts_per_update": 18,
  "seed": 42,
  "learning_rate": 5e-06,
  "max_length": 8192,
  "physical_batch_size": 84,
  "microbatch": 4,
  "buffer_capacity": 100,
  "hindsight_draws": 32,
  "hindsight_weight": 0.3,
  "original_weight": 0.7,
  "continuation_weight": 0.05,
  "modules": {
    "hsl": "train_babyai_hsl",
    "dynamixsft": "train_babyai_dynamixsft",
    "data_agent": "train_babyai_data_agent",
    "dchl": "train_babyai_dchl"
  },
  "data_directory": "babyai_v1",
  "task_pool": "babyai_v1/train.jsonl",
  "workers": 18,
  "save_frequency": 5
}
